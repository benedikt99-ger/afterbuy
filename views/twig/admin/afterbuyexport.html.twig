{% include "headitem.html.twig" with {title: "GENERAL_ADMIN_TITLE"|translate} %}

<form name="myedit" id="myedit" action="{{ oViewConf.getSelfLink() }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ oxid }}">
    <input type="hidden" name="cl" value="afterbuyexport">
<input type="hidden" name="fnc" value="">
    <table cellspacing="0" cellpadding="0" border="0" width="100%">
		<tr><td class="edittext" valign="top"><h3>Bestellnr: {{ ordernr }}</h3></td></tr>
		<tr><td class="edittext" valign="top">
			
	<table style="border : 1px #A9A9A9; border-style : solid solid solid solid; padding-top: 5px; padding-bottom: 5px; padding-right: 5px; padding-left: 5px; width: 600px;">
	<tbody>
		<tr><td class="edittext" colspan="3"> Afterbuy - Informationen </td></tr>        
        <tr><td class="edittext"><b>Afterbuy KundenNr</b><br><input type="text" name="afterbuykdnr" value="{{ afterbuykdnr }}" size="40"></td></tr>
        <tr><td class="edittext" valign="top"><b>Afterbuy UID</b><br><input type="text" name="afterbuyuid" value="{{ afterbuyuid }}" size="40"></td></tr>
	</tbody></table>
	<br><a href="https://farm03.afterbuy.de/Afterbuy/newstatus.aspx?an=10688&ui={{ afterbuyuid}}" target="_blank"><font color="#FF0000">Afterbuy Feedbackseite</font></a>

		</td></tr>
        <tr>
            <td class="edittext" valign="top" style="padding-top: 10px;">
                <input type="submit" class="edittext" name="save" value="Save"
                       onclick="document.myedit.fnc.value='saveData'; return true;">
                &nbsp;
                <input type="submit" class="edittext" name="sendTracking" value="NACH AFTERBUY ÜBETRAGEN"
                       onclick="document.myedit.fnc.value='sendTracking'; return true;">
				<!--
				<input type="submit" class="edittext" name="save" value="NACH AFTERBUY ÜBETRAGEN"><br><br>					   
				-->
            </td>
        </tr>
        {% if sendSuccess === true %}
        <tr>
            <td class="edittext" style="color:green;">Tracking number sent to customer.</td>
        </tr>
        {% elseif sendSuccess === false %}
        <tr>
            <td class="edittext" style="color:red;">Could not send tracking email. Please check the tracking number and customer email.</td>
        </tr>
        {% endif %}
    </table>


</form>

{% include "bottomnaviitem.html.twig" %}
{% include "bottomitem.html.twig" %}

        
